# Copy to .env for local development. Never commit .env or real credentials.
# Phone -> uploader authentication: choose a random value of at least 32 characters.
UPLOAD_TOKEN=replace-with-at-least-32-random-characters
# Admin -> uploader authentication: choose a different random value (32+ characters).
ADMIN_TOKEN=replace-with-a-different-32-character-secret
# Uploader -> GitHub: fine-grained token restricted to the private vault,
# with repository Contents read/write permission.
GITHUB_TOKEN=replace-with-vault-only-contents-write-token
